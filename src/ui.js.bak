import { buildWhatsAppUrl } from "./utils/whatsapp.js";
import { filterProducts } from "./utils/filter.js";

// Konfigurasi nomor WA pemilik (nonrahasia, dapat diubah)
const WA_PHONE = "+6281234567890";

export function renderCatalog(list) {
  const app = document.getElementById("app");
  if (!app) return;

  const categories = ["Semua", "Makanan", "Minuman", "Snack", "Bumbu"];

  app.innerHTML = `
    <header class="navbar">
      <div class="logo">Rasa<span>Nusa</span></div>
      <nav class="nav-links">
        <a href="#catalog">Katalog</a>
        <a href="#tentang">Tentang</a>
      </nav>
    </header>

    <section class="hero">
      <h1>RasaNusa</h1>
      <p>Katalog produk UMKM makanan dan minuman lokal. Dibuat dengan bahan pilihan, rasa otentik, dan pengiriman cepat.</p>
      <a class="btn-primary" href="#catalog">Lihat Katalog</a>
    </section>

    <section id="catalog" class="catalog-section">
      <div class="toolbar">
        <input type="search" id="search-input" placeholder="Cari produk..." aria-label="Cari produk" />
        <div class="filter-group">
          <select id="category-select" aria-label="Filter kategori">
            ${categories.map((c) => `<option value="${c}">${c}</option>`).join("")}
          </select>
          <select id="sort-select" aria-label="Urutkan">
            <option value="default">Urutan Default</option>
            <option value="harga-asc">Harga Termurah</option>
            <option value="harga-desc">Harga Termahal</option>
            <option value="nama-asc">Nama A–Z</option>
            <option value="nama-desc">Nama Z–A</option>
          </select>
        </div>
      </div>
      <div id="catalog-grid" class="grid"></div>
    </section>

    <footer class="footer">
      <p>© 2026 RasaNusa</p>
    </footer>
  `;

  // State
  const state = {
    query: "",
    category: "Semua",
    sort: "default",
  };

  const grid = document.getElementById("catalog-grid");
  if (!grid) return;

  function render(list) {
    if (list.length === 0) {
      grid.innerHTML = `<div class="empty-state"><p>Tidak ada produk yang cocok dengan pencarian Anda.</p></div>`;
      return;
    }
    grid.innerHTML = list
      .map((p) => {
        const harga = "Rp " + p.harga.toLocaleString("id-ID");
        const stokLabel = p.stok > 0 ? `Stok: ${p.stok}` : "Stok: 0 (Habis)";
        const disabled = p.stok <= 0 ? "disabled" : "";
        return `
          <article class="card">
            <div class="card-media">
              ${
                p.imageUrl
                  ? `<img src="${p.imageUrl}" alt="${p.nama}" />`
                  : `<div class="ph" role="img" aria-label="placeholder foto ${p.nama}">Foto</div>`
              }
            </div>
            <h3>${p.nama}</h3>
            <p class="cat">${p.kategori}</p>
            <p class="price">${harga}</p>
            <p class="stok">${stokLabel}</p>
            ${
              p.unggulan
                ? `<span class="badge">Unggulan</span>`
                : ""
            }
            <button class="wa" type="button" ${disabled} data-phone="${WA_PHONE}" data-name="${p.nama}" data-price="${p.harga}" data-desc="${p.deskripsi || ""}" >Pesan via WhatsApp</button>
          </article>
        `;
      })
      .join("");
  }

  // Inisialisasi render
  render(list);

  // Event listeners untuk search, filter, sort
  const searchInput = document.getElementById("search-input");
  const categorySelect = document.getElementById("category-select");
  const sortSelect = document.getElementById("sort-select");

  function update() {
    state.query = searchInput.value;
    state.category = categorySelect.value;
    state.sort = sortSelect.value;
    const filtered = filterProducts(list, state);
    render(filtered);
  }

  if (searchInput) searchInput.addEventListener("input", update);
  if (categorySelect) categorySelect.addEventListener("change", update);
  if (sortSelect) sortSelect.addEventListener("change", update);

  // WhatsApp button click handler
  grid.addEventListener("click", (e) => {
    if (e.target.classList.contains("wa")) {
      e.preventDefault();
      const phone = e.target.dataset.phone;
      const nama = e.target.dataset.name;
      const harga = e.target.dataset.price;
      const desc = e.target.dataset.desc;
      const product = { nama, harga, deskripsi: desc };
      try {
        const url = buildWhatsAppUrl(phone, product);
        window.open(url, "_blank");
      } catch (err) {
        console.error("WhatsApp URL error:", err.message);
      }
    }
  });
}